# JARVIS MK-X .gitignore

# API keys and secrets
config/api_keys.json
config/.env
.env

# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
*.spec

# Virtual environments
venv/
.venv/
env/

# Runtime state (databases, caches)
cache/
data/
memory/*.db
memory/*.db-journal
memory/sessions/

# Logs
logs/
*.log
daemon.log

# Temporary
temp/
scratch/
*.tmp

# Benchmark runtime output
benchmark/results/

# Test & Lint output dumps
*_output.txt
*_results.txt
audit.log

# IDE
.kilocode/
.idea/
.vscode/
*.swp
*.swo

# OS
Thumbs.db
.DS_Store
node_modules/
