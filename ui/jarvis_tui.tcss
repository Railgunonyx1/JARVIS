/* jarvis_tui.tcss
   White/black engineering-console theme, green reserved for
   active/healthy status only — matches the mockup exactly:
   thin borders, monospace, dense panels, no decoration for
   decoration's sake. */

Screen {
    background: white;
    color: black;
}

/* ---- Top bar ---- */
#topbar {
    height: 3;
    background: white;
    color: black;
    border-bottom: solid black;
    padding: 0 2;
}
#topbar-title {
    width: auto;
    content-align: left middle;
    text-style: bold;
}
#topbar-center {
    width: 1fr;
    content-align: center middle;
    text-style: bold;
}
#topbar-clock {
    width: auto;
    content-align: right middle;
}

/* ---- Sidebar ---- */
#sidebar {
    width: 22;
    background: white;
    border-right: solid black;
    padding: 1 1;
}
#sidebar ListItem {
    padding: 0 1;
    color: black;
}
#sidebar ListItem.-highlight, #sidebar ListItem:hover {
    background: black 10%;
}
#sidebar ListView:focus > ListItem.--highlight {
    background: #1DB954 25%;
}
#daemon-box {
    border: solid black;
    height: auto;
    margin-top: 1;
    padding: 1 1;
}
#daemon-box .status-dot {
    color: #1DB954;
    text-style: bold;
}

/* ---- Panels ---- */
.panel {
    border: solid black;
    padding: 1 2;
    background: white;
}
.panel-title {
    text-style: bold;
    color: black;
}

/* ---- Toggleable border classes ---- */
.panel-collapsed {
    border: solid #666666;
    background: #f0f0f0;
}
.panel-expanded {
    border: solid black;
    background: white;
}

/* ---- Grid ----
   Spec layout (row-major auto-placement, matching compose() order):
     row 1: System Overview | CPU Sparkline | Provider Status
     row 2: Token Usage     | Active Tasks   | System Logs
     row 3: Todo (Ctrl+T)   | Context (Ctrl+C, 2 rows tall) | Memory Sparkline
   The context panel is the only one that spans 2 grid rows — the
   deliberately "bigger" window. */
#dashboard-grid {
    grid-size: 3 4;
    grid-gutter: 1;
    padding: 1;
}
#panel-overview { column-span: 1; row-span: 1; }
#panel-cpu      { column-span: 1; row-span: 1; }
#panel-providers { column-span: 1; row-span: 1; }
#panel-tokens    { column-span: 1; row-span: 1; }
#panel-tasks     { column-span: 1; row-span: 1; }
#panel-logs      { column-span: 1; row-span: 1; }
#panel-todo      { column-span: 1; row-span: 1; }
#panel-context   { column-span: 1; row-span: 2; }
#panel-mem       { column-span: 1; row-span: 1; }
#panel-plan      { column-span: 1; row-span: 1; }
#panel-skills    { column-span: 1; row-span: 1; }

/* ---- Mode selector ---- */
#mode-select {
    width: auto;
    height: 1;
    background: white;
    color: black;
    border: solid black;
    padding: 0 1;
    margin: 1 1 0 1;
}
#mode-select > .select--option {
    background: white;
    color: black;
}
#mode-select:disabled {
    background: #f0f0f0;
    color: #666666;
}

/* ---- Token usage display ---- */
.token-count {
    text-align: right;
    margin-top: 1;

    color: #1DB954;
}

/* ---- System stats numbers ---- */
#ov-details {

}

/* ---- Status colors: green means active/healthy, nothing else ---- */
.status-online { color: #1DB954; text-style: bold; }
.status-offline { color: #B00020; text-style: bold; }
.status-idle { color: #666666; }

Sparkline {
    color: #1DB954;
    background: white;
}
Sparkline > .sparkline--min-color {
    color: #1DB954 40%;
}
Sparkline > .sparkline--max-color {
    color: #1DB954;
}

ProgressBar > .bar--bar {
    color: #1DB954;
}
ProgressBar > .bar--complete {
    color: #1DB954;
}

DataTable {
    background: white;
    color: black;
}
DataTable > .datatable--header {
    text-style: bold;
    background: white;
    color: black;
}

Log {
    background: white;
    color: black;
    scrollbar-color: black;
}

/* ---- Command bar ---- */
#command-bar {
    height: 3;
    border-top: solid black;
    padding: 0 1;
}
#command-input {
    background: white;
    color: black;
    border: none;
}
#command-prompt {
    color: #1DB954;
    text-style: bold;
    width: auto;
    content-align: left middle;
    padding-right: 1;
}