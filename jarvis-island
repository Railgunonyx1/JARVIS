#!/bin/sh
# Start the JARVIS Dynamic Island overlay from a source checkout.
set -eu
DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)

PY="$DIR/.venv/bin/python"
if [ ! -x "$PY" ]; then
    PY="$DIR/venv/bin/python"
fi
if [ ! -x "$PY" ]; then
    PY=$(command -v python3 || true)
fi
if [ -z "$PY" ] || [ ! -x "$PY" ]; then
    echo "jarvis-island: no usable Python 3 interpreter found" >&2
    exit 1
fi

export PYTHONPATH="$DIR/dynamic-island:$DIR${PYTHONPATH:+:$PYTHONPATH}"
exec "$PY" "$DIR/scripts/island-launcher.py" "$@"
