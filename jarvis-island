#!/bin/sh
# Start the JARVIS Dynamic Island overlay.
# Uses the repo virtualenv when present, otherwise the system python3.
set -e

DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)

PY="$DIR/venv/bin/python"
if [ ! -x "$PY" ]; then
    PY=$(command -v python3 || true)
fi

if [ -z "$PY" ]; then
    echo "jarvis-island: no python3 found on PATH" >&2
    exit 1
fi

# KDE Wayland ignores client window positions; the installed KWin script does
# the top-centre placement. Set JARVIS_ISLAND_X11=1 to fall back to XWayland,
# where Qt can position the window itself.
if [ "${JARVIS_ISLAND_X11:-0}" = "1" ] && [ -n "${DISPLAY:-}" ]; then
    QT_QPA_PLATFORM=xcb
    export QT_QPA_PLATFORM
fi

exec "$PY" "$DIR/jarvis-desktop-island-launcher.py" "$@"
