/* jarvis_tui.tcss
   JARVIS MK-X console theme — warm dark panels, amber accent,
   matching the dockview console prototype (extracted_ui/). */

Screen {
    background: #171614;
    color: #cfc9bf;
}

/* ---- Top bar ---- */
#topbar {
    height: 3;
    background: #1b1a18;
    color: #cfc9bf;
    border-bottom: solid #37342f;
    padding: 0 2;
}
#topbar-title {
    width: auto;
    content-align: left middle;
    text-style: bold;
    color: #c98a3d;
}
#topbar-model {
    width: auto;
    content-align: left middle;
    color: #9b968b;
    margin-left: 2;
}
#topbar-daemon {
    width: 1fr;
    content-align: right middle;
    padding-right: 2;
}
#topbar-clock {
    width: auto;
    content-align: right middle;
    color: #9b968b;
}

/* ---- Panels ---- */
.panel {
    border: round #37342f;
    padding: 0 1;
    background: #1b1a18;
}
.panel-title {
    text-style: bold;
    color: #c98a3d;
    padding: 0 0 0 1;
    height: 2;
    content-align: left middle;
}

/* ---- Main console grid ----
   row 1: chat (2 rows) | timeline (2 rows) | telemetry | memory
   row 2: (chat)        | (timeline)        | logs      | tasks   */
#mkx-grid {
    grid-size: 4 2;
    grid-gutter: 1;
    grid-columns: 2fr 2fr 2fr 2fr;
    grid-rows: 1fr 1fr;
    padding: 1;
}
#panel-chat      { column-span: 1; row-span: 2; }
#panel-timeline  { column-span: 1; row-span: 2; }
#panel-telemetry { column-span: 1; row-span: 1; }
#panel-logs      { column-span: 1; row-span: 1; }
#panel-memory    { column-span: 1; row-span: 1; }
#panel-tasks     { column-span: 1; row-span: 1; }

/* ---- Bottom rail: skills | providers | plan ---- */
#bottom-rail {
    height: 10;
    padding: 0 1 1 1;
    background: #171614;
}
#bottom-rail > .panel {
    width: 1fr;
    margin-right: 1;
}
#bottom-rail > .panel:last-child {
    margin-right: 0;
}

/* ---- Chat ---- */
#chat-view {
    height: 1fr;
    background: #1b1a18;
    color: #cfc9bf;
    border: none;
    scrollbar-color: #4a453d;
}
#chat-status {
    height: 1;
    color: #c98a3d;
    text-style: bold;
    padding: 0 1;
}
#chat-input {
    height: 3;
    margin: 0 0 1 0;
    border: round #37342f;
    background: #201e1b;
    color: #cfc9bf;
    padding: 0 1;
}
#chat-input:focus {
    border: round #7a5427;
}

/* ---- Timeline ---- */
#timeline-view {
    height: 1fr;
    background: #1b1a18;
    color: #cfc9bf;
    border: none;
    scrollbar-color: #4a453d;
}

/* ---- Logs ---- */
#logs-view {
    height: 1fr;
    background: #1b1a18;
    color: #cfc9bf;
    border: none;
    scrollbar-color: #4a453d;
}

/* ---- Memory / files / telemetry text ---- */
#memory-view, #files-view, #telemetry-view {
    height: 1fr;
    background: #1b1a18;
    color: #cfc9bf;
    border: none;
}

/* ---- Mode selector ---- */
#mode-select {
    width: auto;
    height: 1;
    background: #201e1b;
    color: #cfc9bf;
    border: round #37342f;
    padding: 0 1;
    margin: 1 1 0 1;
}
#mode-select > .select--option {
    background: #201e1b;
    color: #cfc9bf;
}
#mode-select:disabled {
    background: #23211e;
    color: #7d776e;
}

/* ---- Status colors ---- */
.status-online { color: #6ee7a8; text-style: bold; }
.status-offline { color: #e0695c; text-style: bold; }
.status-idle { color: #7d776e; }

Sparkline {
    color: #c98a3d;
    background: #1b1a18;
}
Sparkline > .sparkline--min-color {
    color: #c98a3d 40%;
}
Sparkline > .sparkline--max-color {
    color: #c98a3d;
}

ProgressBar > .bar--bar {
    color: #c98a3d;
}
ProgressBar > .bar--complete {
    color: #c98a3d;
}

DataTable {
    background: #1b1a18;
    color: #cfc9bf;
}
DataTable > .datatable--header {
    text-style: bold;
    background: #201e1b;
    color: #9b968b;
}
DataTable > .datatable--cursor {
    background: #2c2a25;
    color: #cfc9bf;
}
DataTable > .datatable--odd-row {
    background: #1b1a18;
}

Log {
    background: #1b1a18;
    color: #cfc9bf;
    scrollbar-color: #4a453d;
}
