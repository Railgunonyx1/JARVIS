#!/usr/bin/env python3
"""Jarvis autostart control for source and installed layouts.

Usage:
    jarvis-autostart enable [--run COMMAND]
    jarvis-autostart disable
    jarvis-autostart status
"""

from __future__ import annotations

import argparse
import logging
import sys
from pathlib import Path

# The installed layout is:
#   jarvis-repo/scripts/jarvis-autostart
#   jarvis-repo/dynamic-island/app/autostart.py
_HERE = Path(__file__).resolve().parent
_REPO_ROOT = _HERE.parent
_ISLAND_ROOT = _REPO_ROOT / "dynamic-island"
if (_ISLAND_ROOT / "app").is_dir():
    sys.path.insert(0, str(_ISLAND_ROOT))
else:
    sys.path.insert(0, str(_REPO_ROOT))

from app import autostart  # noqa: E402

logger = logging.getLogger("jarvis.autostart")

_STATUS_ON = "autostart enabled"
_STATUS_OFF = "autostart disabled"


def _build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="jarvis-autostart",
        description="Enable/disable the JARVIS Dynamic Island autostart entry.",
    )
    mode = parser.add_subparsers(dest="command", required=True, help="Command to run")

    p_enable = mode.add_parser("enable", help="Write the log-in entry (idempotent).")
    p_enable.add_argument(
        "--run",
        dest="run_command",
        default=None,
        help="Command to launch (defaults to the installed launcher).",
    )
    mode.add_parser("disable", help="Remove only JARVIS's own entry.")
    mode.add_parser("status", help="Print whether the entry is present.")
    return parser


def _configure_logging() -> None:
    logging.basicConfig(level=logging.INFO, format="%(levelname)s: %(message)s")


def main() -> int:
    _configure_logging()
    args = _build_parser().parse_args()

    if args.command == "enable":
        ok = autostart.enable(args.run_command)
        print(f"Autostart {'enabled' if ok else 'FAILED'}")
        return 0 if ok else 1
    if args.command == "disable":
        ok = autostart.disable()
        print(f"Autostart {'disabled' if ok else 'FAILED'}")
        return 0 if ok else 1
    if args.command == "status":
        enabled = autostart.is_enabled()
        print(_STATUS_ON if enabled else _STATUS_OFF)
        return 0

    return 2


if __name__ == "__main__":
    sys.exit(main())
