[Desktop Entry]
Name=JARVIS Desktop Companion
GenericName=AI Desktop Assistant
Comment=Lightweight AI desktop assistant with voice, gestures, and 3D workspace
Exec=jarvis-desktop %F
Icon=jarvis-desktop
Terminal=false
Type=Application
Categories=Office;Utility;AI;Chat;
Keywords=jarvis;assistant;ai;voice;gesture;chat;
StartupNotify=true
MimeType=text/plain;
Actions=Settings;GestureMode;Workspace;

[Desktop Action Settings]
Name=Settings
Exec=jarvis-desktop --settings
Icon=jarvis-desktop

[Desktop Action GestureMode]
Name=Gesture Mode
Exec=jarvis-desktop --gesture
Icon=jarvis-desktop

[Desktop Action Workspace]
Name=3D Workspace
Exec=jarvis-desktop --workspace
Icon=jarvis-desktop
