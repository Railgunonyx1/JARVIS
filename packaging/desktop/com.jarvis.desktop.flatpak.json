{
  "app-id": "com.jarvis.desktop",
  "runtime": "org.kde.Platform",
  "runtime-version": "6.6",
  "sdk": "org.kde.Sdk",
  "command": "jarvis-desktop",
  "finish-args": [
    "--device=dri",
    "--device=all",
    "--talk-name=org.freedesktop.Flatpak.DevicePortal",
    "--socket=wayland",
    "--socket=x11",
    "--socket=session-dbus",
    "--socket=fallback-dbus",
    "--device=video0",
    "--device=snd",
    "--share=network",
    "--persist=.jarvis-desktop"
  ],
  "build-options": {
    "append-ld-library-path": "/app/lib"
  },
  "modules": [
    {
      "name": "pyside6",
      "buildsystem": "simple",
      "build-commands": [
        "pip3 install --prefix=/app PySide6"
      ],
      "sources": []
    },
    {
      "name": "jarvis-core",
      "buildsystem": "simple",
      "build-commands": [
        "mkdir -p /app/lib/jarvis",
        "cp -r core /app/lib/jarvis/",
        "cp -r providers /app/lib/jarvis/",
        "cp -r tools /app/lib/jarvis/",
        "cp -r runtime /app/lib/jarvis/",
        "cp -r memory /app/lib/jarvis/",
        "cp -r skills /app/lib/jarvis/",
        "mkdir -p /app/lib/jarvis/config",
        "cp config/models.toml /app/lib/jarvis/config/",
        "cp -r jarvis-desktop/app /app/lib/jarvis/jarvis-desktop-app",
        "ln -s /app/lib/jarvis/jarvis-desktop-app/main.py /app/bin/jarvis-desktop"
      ],
      "sources": [
        {
          "type": "dir",
          "path": "core",
          "dest": "core"
        },
        {
          "type": "dir",
          "path": "providers",
          "dest": "providers"
        },
        {
          "type": "dir",
          "path": "tools",
          "dest": "tools"
        },
        {
          "type": "dir",
          "path": "runtime",
          "dest": "runtime"
        },
        {
          "type": "dir",
          "path": "memory",
          "dest": "memory"
        },
        {
          "type": "dir",
          "path": "skills",
          "dest": "skills"
        },
        {
          "type": "dir",
          "path": "config",
          "dest": "config"
        },
        {
          "type": "dir",
          "path": "jarvis-desktop/app",
          "dest": "jarvis-desktop-app"
        }
      ]
    }
  ]
}
