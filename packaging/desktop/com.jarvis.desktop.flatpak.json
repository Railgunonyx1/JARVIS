{
  "app-id": "com.jarvis.desktop",
  "runtime": "org.kde.Platform",
  "runtime-version": "6.6",
  "sdk": "org.kde.Sdk",
  "command": "jarvis-island",
  "finish-args": [
    "--device=dri",
    "--socket=wayland",
    "--socket=x11",
    "--socket=pulseaudio",
    "--device=camera",
    "--share=network",
    "--persist=.jarvis-desktop"
  ],
  "build-options": {
    "append-ld-library-path": "/app/lib"
  },
  "modules": [
    {
      "name": "pyside6",
      "buildsystem": "simple",
      "build-commands": [
        "pip3 install --prefix=/app 'PySide6==6.8.1' 'sounddevice==0.5.5' 'numpy>=1.26' 'psutil>=5.9' 'onnxruntime>=1.17' 'kokoro-onnx>=0.4' 'edge-tts>=7.2' 'pydub>=0.25'"
      ],
      "sources": []
    },
    {
      "name": "jarvis-core",
      "buildsystem": "simple",
      "build-commands": [
        "mkdir -p /app/lib/jarvis",
        "cp -r core /app/lib/jarvis/",
        "cp -r providers /app/lib/jarvis/",
        "cp -r tools /app/lib/jarvis/",
        "cp -r runtime /app/lib/jarvis/",
        "cp -r memory /app/lib/jarvis/",
        "cp -r skills /app/lib/jarvis/",
        "mkdir -p /app/lib/jarvis/config",
        "cp config/models.toml /app/lib/jarvis/config/",
        "mkdir -p /app/lib/jarvis/dynamic-island/app",
        "cp dynamic-island/app/*.py /app/lib/jarvis/dynamic-island/app/ 2>/dev/null || true",
        "cp -r dynamic-island/app/ui /app/lib/jarvis/dynamic-island/app/ 2>/dev/null || true",
        "cp -r dynamic-island/app/integration /app/lib/jarvis/dynamic-island/app/ 2>/dev/null || true",
        "cp -r dynamic-island/app/voice /app/lib/jarvis/dynamic-island/app/ 2>/dev/null || true",
        "cp -r dynamic-island/app/gestures /app/lib/jarvis/dynamic-island/app/ 2>/dev/null || true",
        "cp -r dynamic-island/app/desktop /app/lib/jarvis/dynamic-island/app/ 2>/dev/null || true",
        "cp -r dynamic-island/app/workspace3d /app/lib/jarvis/dynamic-island/app/ 2>/dev/null || true",
        "cp -r dynamic-island/app/diagnostics /app/lib/jarvis/dynamic-island/app/ 2>/dev/null || true",
        "touch /app/lib/jarvis/dynamic-island/app/__init__.py",
        "touch /app/lib/jarvis/jarvis-desktop/__init__.py 2>/dev/null || true",
        "printf '%s\\n' '#!/bin/bash' 'export JARVIS_DESKTOP_HOME=${XDG_DATA_HOME:-$HOME/.local/share}/jarvis-desktop' 'mkdir -p \"$JARVIS_DESKTOP_HOME\"' 'export PYTHONPATH=/app/lib/jarvis:/app/lib/jarvis/dynamic-island:${PYTHONPATH:-}' 'exec /app/bin/python -c \"import sys; sys.path.insert(0, '/app/lib/jarvis'); sys.path.insert(0, '/app/lib/jarvis/dynamic-island'); from app.island_main import main; sys.exit(main())\" \"$@\"' > /app/bin/jarvis-island",
        "chmod +x /app/bin/jarvis-island",
        "printf '%s\\n' '#!/bin/bash' 'export JARVIS_DESKTOP_HOME=${XDG_DATA_HOME:-$HOME/.local/share}/jarvis-desktop' 'mkdir -p \"$JARVIS_DESKTOP_HOME\"' 'export PYTHONPATH=/app/lib/jarvis:/app/lib/jarvis/dynamic-island:${PYTHONPATH:-}' 'exec /app/bin/python -c \"import sys; sys.path.insert(0, '/app/lib/jarvis'); sys.path.insert(0, '/app/lib/jarvis/dynamic-island'); from app.island_main import main; sys.exit(main())\" \"$@\"' > /app/bin/jarvis-desktop",
        "chmod +x /app/bin/jarvis-desktop"
      ],
      "sources": [
        { "type": "dir", "path": "core", "dest": "core" },
        { "type": "dir", "path": "providers", "dest": "providers" },
        { "type": "dir", "path": "tools", "dest": "tools" },
        { "type": "dir", "path": "runtime", "dest": "runtime" },
        { "type": "dir", "path": "memory", "dest": "memory" },
        { "type": "dir", "path": "skills", "dest": "skills" },
        { "type": "dir", "path": "config", "dest": "config" },
        { "type": "dir", "path": "dynamic-island/app", "dest": "dynamic-island/app" }
      ]
    }
  ]
}
