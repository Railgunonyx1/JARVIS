{
  "name": "jarvis-orbit",
  "version": "0.1.0",
  "description": "JARVIS Orbit — A custom Chromium browser with native AI intelligence",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux"
  },
  "author": "JARVIS Orbit",
  "license": "MIT",
  "dependencies": {
    "electron-store": "^8.1.0",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.jarvis.orbit",
    "productName": "JARVIS Orbit",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "python/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "src/icons/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "src/icons/icon.icns"
    },
    "linux": {
      "target": "AppImage",
      "icon": "src/icons/icon.png"
    }
  }
}
